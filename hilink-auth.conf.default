<LocationMatch "^/(hilink-dash\.html|cgi-bin/sms-gw\.pl)">
  AuthType Basic
  AuthName "Hilink SMS Gateway"
  AuthUserFile /var/www/cgi-bin/.htpasswd
  <RequireAny>
    Require valid-user
    Require ip {zabbix}
  </RequireAny>
</LocationMatch>
